# ServEase Environment Configuration Template
# ==============================================================================
# Database Selection:
# - DEVELOPMENT (Local SQLite): USE_LOCAL_SQLITE=true
# - PRODUCTION (Neon PostgreSQL): USE_LOCAL_SQLITE=false
# ==============================================================================
USE_LOCAL_SQLITE=true

# Database URL for Neon Cloud PostgreSQL (Required when USE_LOCAL_SQLITE=false)
# Example: postgresql://neondb_owner:password@ep-cool-name-123456.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-pooler.aws.neon.tech/neondb?sslmode=require

# JWT & Authentication Secret Key
SECRET_KEY=servease_super_secret_jwt_key_2026_vtu_aiml
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gmail SMTP Email Configuration (for OTP delivery)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=ServEase

# OTP Security Configuration
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Environment Mode: development / production
ENVIRONMENT=development
