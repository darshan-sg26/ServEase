# ServEase Backend Environment Configuration Template
# ==============================================================================
# Database Configuration:
# - DEVELOPMENT: Set USE_LOCAL_SQLITE=true to use local SQLite (backend/servease.db)
# - PRODUCTION: Set USE_LOCAL_SQLITE=false to connect to Neon PostgreSQL via DATABASE_URL
# ==============================================================================
USE_LOCAL_SQLITE=true
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/neondb?sslmode=require

# JWT & Authentication Secret Key
SECRET_KEY=servease_super_secret_jwt_key_2026_vtu_aiml
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth2 & Gmail API Configuration (HTTPS Port 443)
GOOGLE_CLIENT_ID=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=servease.dev@gmail.com
GMAIL_FROM_NAME=ServEase

# OTP Security Configuration
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Environment Mode: development / production
ENVIRONMENT=development
